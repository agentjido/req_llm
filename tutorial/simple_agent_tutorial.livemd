# SimpleAgent: Streaming and Tool Calling with ReqLLM

```elixir
Mix.install([
  {:req_llm, path: ".."},
  {:abacus, "~> 2.0"},
  {:jason, "~> 1.4"}
])
```

## Introduction

This LiveBook demonstrates building a simple AI agent in two progressive steps:

1. **Basic Streaming**: Stream model responses to console in real-time
2. **Tool Calling**: Add a calculator tool for safe math evaluation

We'll use:

* `ReqLLM.stream_text/3` for streaming chunks
* `ReqLLM.generate_text/3` for final tool-informed responses
* `ReqLLM.Tool` for tool definition
* `ReqLLM.Context` for conversation history
* `Abacus` for safe expression evaluation

## Prerequisites

Set your Anthropic API key:

```bash
export ANTHROPIC_API_KEY=sk-ant-...
```

## Setup

```elixir
model = System.get_env("REQ_LLM_MODEL") || "anthropic:claude-3-7-sonnet-20250219"
```

Quick sanity check:

```elixir
{:ok, response} = ReqLLM.generate_text(model, "Say hi in one sentence.")
text = response.message.content |> List.first() |> Map.get(:text)
IO.puts(text)
```

## Part 1 — Basic Streaming Agent

A minimal GenServer that streams assistant responses to the console.

```elixir
defmodule SimpleAgent.V1 do
  use GenServer
  alias ReqLLM.Context
  import ReqLLM.Context

  defstruct [:model, :history]

  def start_link(opts \\ []) do
    GenServer.start_link(__MODULE__, opts, name: Keyword.get(opts, :name))
  end

  @impl true
  def init(opts) do
    system_prompt = """
    You are a helpful teacher. Keep explanations short and clear.
    """

    model = Keyword.get(opts, :model)
    history = Context.new([system(system_prompt)])
    {:ok, %__MODULE__{model: model, history: history}}
  end

  def ask(pid, user_text) when is_binary(user_text) do
    GenServer.call(pid, {:ask, user_text}, 30_000)
  end

  @impl true
  def handle_call({:ask, user_text}, _from, %{model: model, history: history} = state) do
    history = Context.append(history, user(user_text))

    case ReqLLM.stream_text(model, history.messages) do
      {:ok, stream_response} ->
        final_text =
          stream_response
          |> ReqLLM.StreamResponse.tokens()
          |> Enum.reduce("", fn token, acc ->
            IO.write(token)
            acc <> token
          end)

        IO.write("\n\n")

        history =
          if final_text != "", do: Context.append(history, assistant(final_text)), else: history

        {:reply, {:ok, final_text}, %{state | history: history}}

      {:error, error} ->
        IO.puts("\nError: #{inspect(error)}\n")
        {:reply, {:error, error}, state}
    end
  end
end
```

Try it:

```elixir
{:ok, pid} = SimpleAgent.V1.start_link(model: model)

SimpleAgent.V1.ask(pid, "In 2 short sentences, explain what streaming means for LLM responses.")
```

## Part 2 — Add Calculator Tool

Define a safe calculator using Abacus:

```elixir
defmodule SimpleAgent.Tools do
  alias ReqLLM.Tool

  def calculator_tool do
    Tool.new!(
      name: "calculator",
      description:
        "Safely evaluate a mathematical expression string. Example: {\"expression\":\"(2+3)*7\"}",
      parameter_schema: [
        expression: [
          type: :string,
          required: true,
          doc: "Math expression to evaluate, e.g., \"(2+3)^2 / 5\""
        ]
      ],
      callback: &__MODULE__.calculator_cb/1
    )
  end

  def calculator_cb(%{expression: expr}) when is_binary(expr), do: eval(expr)
  def calculator_cb(%{"expression" => expr}) when is_binary(expr), do: eval(expr)

  def calculator_cb(args),
    do: {:error, "Expected %{expression: string}. Got: #{inspect(args)}"}

  defp eval(expr) do
    case Abacus.eval(expr) do
      {:ok, value} -> {:ok, value}
      {:error, reason} -> {:error, "Invalid expression: #{Exception.message(reason)}"}
    end
  end
end
```

Enhanced agent with tool calling:

```elixir
defmodule SimpleAgent do
  use GenServer

  alias ReqLLM.{Context, Tool}
  import ReqLLM.Context

  defstruct [:model, :history, :tools]

  def start_link(opts \\ []) do
    GenServer.start_link(__MODULE__, opts, name: Keyword.get(opts, :name))
  end

  @impl true
  def init(opts) do
    system_prompt = """
    You are a helpful assistant with access to one tool.

    - When a user asks a math question or expression, use the calculator tool with the "expression" parameter.
    - Provide only valid JSON for tool arguments; do not add extra text in the arguments.
    - After tool results are provided, give a concise final answer.
    """

    model = Keyword.get(opts, :model)

    tools = [
      SimpleAgent.Tools.calculator_tool()
    ]

    history = Context.new([system(system_prompt)])
    {:ok, %__MODULE__{model: model, history: history, tools: tools}}
  end

  def ask(pid, user_text) when is_binary(user_text) do
    GenServer.call(pid, {:ask, user_text}, 30_000)
  end

  @impl true
  def handle_call(
        {:ask, user_text},
        _from,
        %{model: model, history: history, tools: tools} = state
      ) do
    history = Context.append(history, user(user_text))

    case ReqLLM.stream_text(model, history.messages, tools: tools, temperature: 0.0) do
      {:ok, stream_response} ->
        chunks =
          stream_response.stream
          |> Enum.map(fn chunk ->
            if chunk.type == :content and is_binary(chunk.text), do: IO.write(chunk.text)
            chunk
          end)

        IO.write("\n")

        tool_calls = extract_tool_calls_from_chunks(chunks)

        if tool_calls == [] do
          final_text =
            chunks
            |> Enum.reduce("", fn ch, acc ->
              if ch.type == :content and is_binary(ch.text), do: acc <> ch.text, else: acc
            end)

          history = Context.append(history, assistant(final_text))
          {:reply, {:ok, final_text}, %{state | history: history}}
        else
          assistant_text =
            chunks
            |> Enum.reduce("", fn ch, acc ->
              if ch.type == :content and is_binary(ch.text), do: acc <> ch.text, else: acc
            end)

          assistant_message = assistant(assistant_text, tool_calls: tool_calls)
          history = Context.append(history, assistant_message)

          history =
            Enum.reduce(tool_calls, history, fn call, ctx ->
              case Enum.find(tools, &(&1.name == call.name)) do
                %Tool{} = tool ->
                  case Tool.execute(tool, call.arguments) do
                    {:ok, result} ->
                      IO.puts("[tool] #{call.name}(#{inspect(call.arguments)}) -> #{inspect(result)}")

                      tool_msg = tool_result_message(call.name, call.id, result)
                      Context.append(ctx, tool_msg)

                    {:error, reason} ->
                      error_str = if is_binary(reason), do: reason, else: inspect(reason)
                      IO.puts("❌ #{call.name} error: #{error_str}")

                      tool_msg =
                        tool_result_message(call.name, call.id, %{
                          error: error_str
                        })

                      Context.append(ctx, tool_msg)
                  end

                nil ->
                  IO.puts("❌ Tool not found: #{call.name}")
                  ctx
              end
            end)

          case ReqLLM.generate_text(model, history.messages, max_tokens: 256, temperature: 0.0) do
            {:ok, %{message: %{content: [%{text: final_text, type: :text} | _]}}}
            when is_binary(final_text) ->
              IO.puts(final_text)
              history = Context.append(history, assistant(final_text))
              {:reply, {:ok, final_text}, %{state | history: history}}

            {:ok, final_text} when is_binary(final_text) ->
              IO.puts(final_text)
              history = Context.append(history, assistant(final_text))
              {:reply, {:ok, final_text}, %{state | history: history}}

            {:ok, other} ->
              IO.puts(inspect(other))
              history = Context.append(history, assistant("#{inspect(other)}"))
              {:reply, {:ok, other}, %{state | history: history}}

            {:error, err} ->
              IO.puts("Final generate_text error: #{inspect(err)}")
              {:reply, {:error, err}, state}
          end
        end

      {:error, error} ->
        IO.puts("stream_text error: #{inspect(error)}")
        {:reply, {:error, error}, state}
    end
  end

  defp extract_tool_calls_from_chunks(chunks) do
    calls =
      chunks
      |> Enum.filter(&(&1.type == :tool_call))
      |> Enum.map(fn chunk ->
        %{
          id: Map.get(chunk.metadata, :id) || "call_#{:erlang.unique_integer()}",
          name: chunk.name,
          arguments: chunk.arguments || %{},
          index: Map.get(chunk.metadata, :index, 0)
        }
      end)

    arg_fragments =
      chunks
      |> Enum.filter(fn
        %{type: :meta, metadata: %{tool_call_args: _}} -> true
        _ -> false
      end)
      |> Enum.group_by(& &1.metadata.tool_call_args.index)
      |> Map.new(fn {index, fragments} ->
        json = fragments |> Enum.map_join("", & &1.metadata.tool_call_args.fragment)
        {index, json}
      end)

    calls
    |> Enum.map(fn call ->
      case Map.get(arg_fragments, call.index) do
        nil ->
          Map.delete(call, :index)

        json ->
          case Jason.decode(json) do
            {:ok, args} -> call |> Map.put(:arguments, args) |> Map.delete(:index)
            {:error, _} -> Map.delete(call, :index)
          end
      end
    end)
  end
end
```

Try it:

```elixir
{:ok, pid} = SimpleAgent.start_link(model: model)

SimpleAgent.ask(pid, "What is (15 * 7 + 23) / 2? Show your steps briefly.")
```

More examples:

```elixir
SimpleAgent.ask(pid, "Compute sqrt(144) + 3^2")
```

```elixir
SimpleAgent.ask(pid, "If tickets cost 12.5 dollars each, how much for 7 tickets?")
```

## Summary

We built a minimal GenServer agent demonstrating:

* **Streaming**: Real-time text output via `stream_text/3`
* **Tool Calling**: Safe calculator with Abacus
* **Two-step pattern**: Stream to detect tool calls, then `generate_text/3` for final answer

This showcases ReqLLM's core capabilities in a tutorial-friendly format.
