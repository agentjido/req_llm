<.container class="max-w-4xl my-10">
  <.card class="mb-5 p-4">
    <.messages_container messages={@messages} />
  </.card>

  <div class="flex justify-end mb-4">
    <.button
      :if={@messages != []}
      size="sm"
      color="white"
      phx-click="clear"
      label="Clear Chat"
      icon="hero-trash"
    />
  </div>

  <.form for={@form} phx-submit="submit" id="chat-form" class="flex gap-2">
    <div class="flex-1">
      <.input
        field={@form[:message]}
        type="text"
        placeholder="Type your message..."
        id="chat-input"
        aria-label="Chat message input"
        phx-hook="AutoFocusHook"
      />
    </div>

    <.button
      type="submit"
      color="primary"
      size="sm"
      disabled={streaming?(@messages)}
      phx-disable-with="Sending..."
      icon="hero-paper-airplane"
      label={if streaming?(@messages), do: "Sending...", else: "Send"}
      aria-label="Send message"
    />
  </.form>

  <div class="mt-4 text-sm text-gray-500 dark:text-gray-400">
    <.icon name="hero-information-circle" class="inline w-4 h-4" />
    Messages stream in real-time as the AI generates them
  </div>
</.container>

<script>
  /**
   * LiveView Hooks for Streaming Chat
   *
   * This script defines client-side hooks that enhance the streaming chat
   * experience by handling real-time updates and maintaining UI state.
   *
   * IMPORTANT: To use these hooks in a production application, register them
   * in your app.js file instead of defining them inline here. This recipe
   * uses inline registration for teaching purposes.
   */

  /**
   * Auto-scroll messages to bottom
   *
   * Automatically scrolls the messages container to the bottom when new
   * content is added or streamed. This function is "smart scroll" - it only
   * auto-scrolls if the user is already near the bottom, allowing them to
   * scroll up to read earlier messages without being interrupted.
   *
   * @param {void}
   * @returns {void}
   */
  function scrollMessagesToBottom() {
    const container = document.getElementById("chat-messages");
    if (!container) return;

    const scrollTop = container.scrollTop;
    const scrollHeight = container.scrollHeight;
    const clientHeight = container.clientHeight;
    const distanceFromBottom = scrollHeight - scrollTop - clientHeight;

    const isNearBottom = distanceFromBottom < 150;

    if (isNearBottom) {
      requestAnimationFrame(() => {
        container.scrollTop = container.scrollHeight;
      });
    }
  }

  window.addEventListener("phx:update", scrollMessagesToBottom);
  document.addEventListener("DOMContentLoaded", scrollMessagesToBottom);

  /**
   * AutoFocus Hook
   *
   * Enhances the chat input field with two key behaviors:
   *
   * 1. Clears the input when the form is submitted, removing the need for
   *    the server to manage form state clearing
   * 2. Maintains focus on the input after submission, providing a smooth UX
   *    so users can immediately type their next message
   *
   * This hook demonstrates best practices for client-side form handling:
   * - Clear input on submit event (immediate feedback)
   * - Maintain focus for continuous interaction
   * - Also handle the updated lifecycle in case of edge cases
   *
   * Usage:
   *   <input type="text" phx-hook="AutoFocusHook" />
   *
   * How it works:
   * - mounted(): Focuses input on initial render and attaches form submit handler
   * - updated(): Clears and refocuses input if the element is re-rendered
   *   by LiveView (e.g., due to validation errors)
   */
  window.AutoFocusHook = {
    mounted() {
      this.el.focus();

      const form = this.el.closest("form");
      if (form) {
        form.addEventListener("submit", () => {
          setTimeout(() => {
            this.el.value = "";
            this.el.focus();
          }, 0);
        });
      }
    },

    updated() {
      this.el.value = "";
      this.el.focus();
    }
  };

  /**
   * Hook Registration
   *
   * For development/demo purposes, register the hook globally on the liveSocket.
   * In production apps, hooks should be registered in your app.js file as part
   * of the LiveSocket initialization for better performance and modularity.
   */
  if (window.liveSocket && window.liveSocket.hooks) {
    window.liveSocket.hooks.AutoFocusHook = window.AutoFocusHook;
  } else {
    window.LiveViewHooks = window.LiveViewHooks || {};
    window.LiveViewHooks.AutoFocusHook = window.AutoFocusHook;
  }
</script>